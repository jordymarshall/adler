# Server settings. Never use VITE_ for secrets. npm run dev reads .env.
# Docker compose also reads .env; npm start expects environment variables.
PUBLIC_URL=
# When Vercel proxies /api to this server: exact Vercel/custom-domain origin.
# PUBLIC_URL remains the backend's public HTTPS origin (also used by Twilio).
FRONTEND_ORIGIN=
# Vercel build setting only: the backend's public HTTPS origin, without a path.
ADLER_BACKEND_URL=
PORT=8080
ADLER_DATA_DIR=.data
# Set to closed after creating the accounts you need if registration is private.
ADLER_REGISTRATION=open
# In production, users bring their own API keys by default.
# Set true only if this server should pay for every allowed user's model calls.
ADLER_ALLOW_SERVER_KEYS=false
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Calendar OAuth. Use your public HTTPS callback when deployed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:55011/api/calendar/google/callback

# Native iMessage + RCS/SMS fallback via Linq; use twilio for SMS-only.
MESSAGING_PROVIDER=linq
LINQ_API_KEY=
LINQ_NUMBER=
# Secret returned when creating the Linq webhook subscription.
LINQ_WEBHOOK_SECRET=

# Optional SMS-only Twilio deployment (MESSAGING_PROVIDER=twilio).
# PUBLIC_URL must be the exact public HTTPS backend origin.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
